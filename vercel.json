{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://feedia1.onrender.com/api/:path*"
    },
    {
      "source": "/google-tts/:path*",
      "destination": "https://translate.google.com/:path*"
    },
    {
      "source": "/((?!api/|google-tts/).*)",
      "destination": "/index.html"
    }
  ]
}
